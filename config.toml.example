# Copy this file to ~/.config/flowcloze/config.toml
provider = "gemini"
model = "gemini-2.5-flash"
# base_url = "http://localhost:11434/v1"
batch = "auto"
max_tasks_per_batch = 8
max_input_tokens = 12000
max_concurrent_batches = 3
rewrite = "always"
fallback = "error"
structured_output = "auto"

# Select a quota profile to enable quota-aware batch planning and request pacing.
# The Gemini values below are an example for a 5 RPM / 250K TPM / 20 RPD project;
# adjust every value to the limits shown for your own project/tier.
quota_profile = "gemini"

[quota_profiles.gemini]
rpm = 5
tpm = 250000
rpd = 20
reserve_requests = 4
adaptive_max_tasks_per_batch = 12
adaptive_max_input_tokens = 18000

# Model-specific values override the provider profile when present.
# [quota_profiles.gemini.models."gemini-3.8-flash"]
# rpm = 5
# tpm = 250000
# rpd = 20

# OpenAI and Mistral use the same quota schema. Fill in the values for your tier,
# then set quota_profile = "openai" or "mistral" above.
[quota_profiles.openai]
reserve_requests = 0
adaptive_max_tasks_per_batch = 12
adaptive_max_input_tokens = 18000
# rpm = 500
# tpm = 30000
# rpd = 10000

[quota_profiles.mistral]
reserve_requests = 0
adaptive_max_tasks_per_batch = 12
adaptive_max_input_tokens = 18000
# rpm = 60
# tpm = 500000
# rpd = 1000

# The bundled Typst template is materialized automatically when PDF output is used.
# Set this only to override it with your own template.
# typst_template = "/path/to/custom.typ"
