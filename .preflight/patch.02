+/// 1 qblockの生成・検証に失敗した理由．
 #[derive(Debug)]
 struct TaskFailure {
-    /// 失敗したtaskのindex．
     index: usize,
-    /// indexではなく公開task IDを失敗報告へ残す．
     task_id: String,
-    /// 失敗時点のretry回数．
