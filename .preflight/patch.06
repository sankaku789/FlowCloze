-            class.detail()
+            class.detail(),
+            quota
         );
+        if let Some(reason) = http_status_reason(status) {
+            return format!("Provider error: HTTP {status} {reason} ({details})");
+        }
+        return format!("Provider error: HTTP {status} ({details})");
     }
 
