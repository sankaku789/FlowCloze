# APIキーはプレースホルダーだけを置き、config.tomlには保存しません。
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
LOCAL_LLM_API_KEY=YOUR_LOCAL_LLM_API_KEY

# canonical environment variables
# FLOWCLOZE_CONFIG=config.toml
# FLOWCLOZE_PROVIDER=gemini
# FLOWCLOZE_MODEL=gemini-2.5-flash
# FLOWCLOZE_API_KEY_ENV=GEMINI_API_KEY
FLOWCLOZE_BASE_URL=
FLOWCLOZE_BATCH_POLICY=auto
FLOWCLOZE_MAX_TASKS_PER_BATCH=8
FLOWCLOZE_MAX_INPUT_TOKENS=12000
FLOWCLOZE_MAX_CONCURRENT_BATCHES=3
FLOWCLOZE_REWRITE=always
FLOWCLOZE_FALLBACK=error
FLOWCLOZE_STRUCTURED_OUTPUT=auto

# Legacy aliases (canonical variables take precedence):
# FLOWCLOZE_LLM_BACKEND=gemini  # use FLOWCLOZE_PROVIDER instead
# LOCAL_LLM_BASE_URL=            # use FLOWCLOZE_BASE_URL instead
